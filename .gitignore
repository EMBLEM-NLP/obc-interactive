# transient build/verify state — regenerated by ci/regenerate.sh and run_gates.py
# subagent worktrees. `isolation: worktree` puts a full checkout under here;
# without this line `git add -A` commits a copy of the repo into the repo.
.claude/worktrees/
__pycache__/
*.pyc
.regen.stamp
verify/*/out/
pipeline/emitters/out/
ci/gate-board.json
assets/figures-v1/
assets/front-matter-v1/
assets/inline-raster-v1/
assets/table-raster-v1/
assets/MANIFEST.sha256
assets/manifest.json
/tmp/
# stage18's intermediate; retrieval/run.sh recreates it from obc-vec.sqlite
emitters/obc-defs.sqlite
# the two Crown-copyright source PDFs are fetch-only (see fetch.txt); never commit
data/source/
301880.pdf
301881.pdf

# --- derived binaries: fetched, not committed (see data-manifest.json) ---
# 315 MB, all regenerable or re-fetchable. Kept out of git so every clone is
# small and identical, and so nothing depends on Git LFS.
pdf/*.pdf
emitters/*.sqlite
emitters/*.tar.gz
model/*.jsonl.gz
model/*.json.gz
verify/data/**/*.gz
verify/data/**/*.json
